/*
 * Copyright (c) 2025
 * SPDX-License-Identifier: Apache-2.0
 *
 * CC1352P1 LaunchXL board overlay for the TI IWRL6322 mmWave sensor sample.
 *
 * Pin wiring (DIO number -> IWRL6322 signal):
 *
 *  DIO8   SPI_MISO         MISO   (board pinctrl: spi0_miso_default)
 *  DIO9   SPI_MOSI         MOSI   (board pinctrl: spi0_mosi_default)
 *  DIO10  SPI_CLK          CLK    (board pinctrl: spi0_sck_default)
 *  DIO15  SPI_CS           CSN    driven as a GPIO via cs-gpios
 *  DIO19  nRESET           nRESET
 *  DIO7   SPI_BUSY         MCU_DEVICE_BUSY
 *  DIO22  WAKE_UP          WAKE_UP (SOP1 on the breakout)
 *  DIO6   PRESENCE_DETECT  PRESENCE_DETECT / HOST_IRQ
 *  DIO11  SOP0             SOP0 (pull-down -> SPI boot mode)
 *  DIO20  SOP1             SOP1 (pull-down -> SPI boot mode)
 *
 * GPIO flag notes:
 *   cs-gpios          - GPIO_ACTIVE_LOW: SPI CS is asserted LOW.  A GPIO is
 *                       used instead of the SPI0_FSS hardware pin so that CS
 *                       stays asserted for the entire multi-byte packet; the
 *                       CC1352P1 hardware FSS would deassert between bytes
 *                       when the TX FIFO drains.
 *   nreset-gpios      - GPIO_ACTIVE_HIGH: gpio_pin_set_dt(0) drives the pin
 *                       LOW (reset asserted), gpio_pin_set_dt(1) releases it.
 *   spi-busy-gpios    - GPIO_ACTIVE_HIGH: the pin idles HIGH between
 *                       transactions; the TI library waits for LOW before a
 *                       command and HIGH before the next transfer.
 *   wake-up/pres      - GPIO_ACTIVE_HIGH: read or driven at the physical level.
 *
 * Power: the IWRL6322 draws noticeably more current once MPD processing is
 * running.  If the board powers the radar through a jump-start USB cable,
 * leave that cable connected, otherwise the supply can sag and drop the
 * LaunchPad off USB.
 */

/* Set UART0 (zephyr,console) to 921600 baud for raw data streaming */
&uart0 {
	current-speed = <921600>;
};

&spi0 {
	/*
	 * Override pinctrl to remove the hardware SPI0_FSS mux on DIO11.
	 * CS is instead driven by cs-gpios below (GPIO mode keeps CS asserted
	 * for the full packet — hardware FSS would deassert per byte).
	 */
	pinctrl-0 = <&spi0_sck_default &spi0_mosi_default &spi0_miso_default>;
    	pinctrl-names = "default";
	cs-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;

	iwrl6322: iwrl6322@0 {
		compatible = "ti,iwrl6322";
		reg = <0>;
		spi-max-frequency = <1000000>; /* 1 MHz */

		/*
		 * nRESET: asserted (low) at init, released (high) at power-up.
		 * Use ACTIVE_HIGH so gpio_pin_set_dt(0)→LOW and (1)→HIGH.
		 */
		nreset-gpios          = <&gpio0 19 GPIO_ACTIVE_HIGH>;

		/*
		 * SPI_BUSY: idles HIGH between transactions.
		 * ACTIVE_HIGH so gpio_pin_get_dt returns the physical level that
		 * the TI library waits on (LOW before a command, HIGH after).
		 */
		spi-busy-gpios        = <&gpio0 7 GPIO_ACTIVE_HIGH>;

		/* WAKE_UP: assert HIGH to keep device active, deassert to allow deep sleep */
		wake-up-gpios         = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

		/*
		 * PRESENCE_DETECT: device asserts HIGH on each frame (verbose mode)
		 * or when occupancy is detected (presence mode).
		 * Wiring this pin enables SENSOR_TRIG_DATA_READY.
		 */
		presence-detect-gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		sop0-gpios = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		sop1-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;

	};
};
