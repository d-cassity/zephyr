 * SPDX-License-Identifier: Apache-2.0
 *
 * LP-EM-CC2340R53 board overlay for the IWRL6322 sensor sample.
 *
 * Pin wiring (BoosterPack header -> IWRL6322):
 *
 *  DIO   BP Header  Signal              IWRL6322 pin
 *  ------------------------------------------------
 *  DIO18  BP-7      SPI_CLK (SCK)       CLK
 *  DIO13  BP-15     SPI_MOSI            MOSI
 *  DIO12  BP-14     SPI_MISO            MISO
 *  DIO10  BP-18     SPI_CS              CS    <- GPIO CS via cs-gpios
 *  DIO6   BP-38     nRESET              nRESET
 *  DIO19  BP-5      WAKE_UP / SOP1      WAKE_UP (dual-use: also SOP1)
 *  DIO14  BP-36     PRESENCE_DETECT     PRESENCE_DETECT
 *  DIO15  (header)  SPI_BUSY            MCU_DEVICE_BUSY
 *  DIO11  (header)  SOP0                MCU_HOSTIRQ_SOP0 (boot: SOP0, run: HOST_IRQ)
 *
 * The board's pinctrl-0 for spi0 includes a 4th CS pin which causes the SPI
 * driver to use hardware CS instead of the GPIO CS on DIO10.  Override
 * pinctrl-0 with a 3-pin state (SCK, MOSI, MISO only) so the driver falls
 * through to use cs-gpios for chip select.
 *
 * DIO19 is dual-use: driven as SOP1 (output low) at boot, then reasserted as
 * WAKE_UP during operation.  DIO11 is only listed as sop0-gpios; it is driven
 * low at boot and left as an output (HOST_IRQ is not used by the driver).
 */

#include <zephyr/dt-bindings/pinctrl/cc23x0-pinctrl.h>

/* Remove the on-board flash so IWRL6322 can take CS index 0. */
/delete-node/ &mx25r80;

&spi0 {
	/* 3-pin pinctrl — no HW CS pin, driver uses cs-gpios */
	pinctrl-0 = <&spi0_sck_default &spi0_mosi_default &spi0_miso_default>;
	pinctrl-1 = <&spi0_sck_sleep &spi0_mosi_sleep &spi0_miso_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;  /* DIO10 (BP-18) */

	iwrl6322: iwrl6322@0 {
		compatible = "ti,iwrl6322";
		reg = <0>;
		spi-max-frequency = <1000000>; /* 1 MHz */

		nreset-gpios          = <&gpio0 6  GPIO_ACTIVE_HIGH>;
		spi-busy-gpios        = <&gpio0 15 GPIO_ACTIVE_HIGH>;  /* MCU_DEVICE_BUSY */
		wake-up-gpios         = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		presence-detect-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		sop0-gpios            = <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
		sop1-gpios            = <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
	};
};
