	int "FE number of frames (0=infinite, 1..65535)"
	range 0 65535
	default 0

config IWRL6322_FE_FRAME_PERIOD_MS
	int "FE frame periodicity (ms, 10..21600000)"
	range 10 21600000
	default 200

