config IWRL6322
	bool "TI IWRL6322 mmWave Radar Sensor"
	select SPI
	select GPIO
	select CRC
	depends on DT_HAS_TI_IWRL6322_ENABLED
	select SENSOR_ASYNC_API
	help
	  Enable the TI IWRL6322 60-64 GHz mmWave radar sensor driver.

# ============================================================================
# Work queue / timing
# ============================================================================

config IWRL6322_WORK_QUEUE_STACK_SIZE
	int "Sensor work queue stack size"
	default 4096
	help
	  Stack size for the dedicated mmWave sensor work queue.

config IWRL6322_WORK_QUEUE_PRIORITY
	int "Sensor work queue thread priority"
	default 5
	help
	  Thread priority for the dedicated mmWave sensor work queue.

config IWRL6322_DEBUG_LOG
	bool "TI library debug logging"
	default n
	help
	  When enabled, TI library printf callbacks emit debug-level log messages.

# ============================================================================
# RTIO buffer sizing
# ============================================================================

config IWRL6322_MAX_PAYLOAD_BYTES
	int "Maximum sensor data payload (bytes)"
	range 64 32768
	default 4096
	help
	  Size of the RTIO payload buffer allocated for each sensor data fetch.
	  Must be large enough for the largest expected sensor data packet.

# ============================================================================
# API timeout
# ============================================================================

config IWRL6322_API_TIMEOUT_MS
	int "TI library API response timeout (ms)"
	range 1 255
	default 10
	help
	  Maximum time in milliseconds to wait for a SPI command response
	  from the IWRL6322. Passed to mmWaveULink as h_DeviceRspTimeoutMs.

# ============================================================================
# Operating mode defaults
# ============================================================================

config IWRL6322_DEFAULT_MODE
	int "Default operating mode at startup"
	range 0 5
	default 0
	help
	  Default operating mode applied at driver initialisation.
	  0 = STOP (sensor idle after init, user must set mode via attr_set)
	  1 = RAW_ADC (FE mode, raw ADC data)
	  2 = 1D_FFT  (FE mode, 1D-FFT processed data)
	  3 = MPD_PRESENCE (MPD quiet mode, data only when presence detected)
	  4 = MPD_VERBOSE  (MPD verbose mode, data every frame)
	  5 = POWER_OFF    (assert nRESET on init)

# ============================================================================
# Antenna / region
# ============================================================================

config IWRL6322_ANTENNA_TYPE
	int "Antenna type (b3_DevAntennaSel)"
	range 0 3
	default 0
	help
	  0 = AoP module (default)
	  1 = WCSP 3D antenna
	  2 = WCSP 2D antenna
	  3 = WCSP-Z antenna

config IWRL6322_REGION
	int "Regulatory region (0=FCC, 1=TELEC)"
	range 0 1
	default 0
	help
	  0 = FCC / CE worldwide operation
	  1 = Japan TELEC compliance

# ============================================================================
# FE chirp profile defaults
# ============================================================================

config IWRL6322_FE_ADC_SAMP_RATE
	int "FE ADC sampling rate divider (c_AdcSampRate, 8..100)"
	range 8 100
	default 16

config IWRL6322_FE_NUM_VIRTUAL_ANT
	int "FE number of virtual antennas (1..4)"
	range 1 4
	default 4

config IWRL6322_FE_TXRX_CH_ENA
	hex "FE TX/RX channel enable bitmask (h_ChirpTxRxChEnaSel)"
	default 0xA965

config IWRL6322_FE_NUM_ADC_SAMPLES
	int "FE number of ADC samples per chirp (32/64/128/256)"
	range 32 256
	default 128

config IWRL6322_FE_RAMP_END_TIME
	int "FE chirp ramp end time (100 ns LSB, range 60..2560)"
	range 60 2560
	default 280

config IWRL6322_FE_IDLE_TIME
	int "FE chirp idle time (100 ns LSB, range 31..10000)"
	range 31 10000
	default 1000

config IWRL6322_FE_ADC_SKIP_SAMP
	int "FE ADC start skip samples (0..63)"
	range 0 63
	default 63

config IWRL6322_FE_RF_FREQ_START
	hex "FE RF start frequency (w_ChirpRfFreqStart)"
	default 0xC800

config IWRL6322_FE_RF_FREQ_SLOPE
	int "FE RF frequency slope (xh_ChirpRfFreqSlope, signed, ±13981)"
	range -13981 13981
	default 3495

config IWRL6322_FE_TX_START_TIME
	int "FE TX start time (20 ns LSB, range -300..300)"
	range -300 300
	default 0

config IWRL6322_FE_HPF_CORNER
	int "FE HPF corner frequency (0=175kHz, 1=350kHz, 2=700kHz, 3=1400kHz)"
	range 0 3
	default 0

config IWRL6322_FE_CAL_RX_GAIN
	int "FE calibration RX gain (34..48 dB, even values only)"
	range 34 48
	default 36

config IWRL6322_FE_CAL_TX_BACKOFF
	int "FE calibration TX backoff (0..15 dB)"
	range 0 15
	default 0

config IWRL6322_FE_INTER_CHIRP_PS_OVRD
	int "FE interchirp power save settings"
	range 0 127
	default 0

# ============================================================================
# FE chirp frame defaults
