	int "MPD detection mode (1=1VA_1D, 2=2VA_2D, 3=3VA_3D, 4=4VA_3D)"
	range 1 4
	default 3

config IWRL6322_MPD_MAX_RANGE
	int "MPD maximum range (0=4m, 1=8m, 2=12m)"
	range 0 2
	default 0

config IWRL6322_MPD_MOTION_SENSITIVITY
	int "MPD motion sensitivity (0=lowest, 3=highest)"
	range 0 3
	default 0

config IWRL6322_MPD_DETECTION_SENSITIVITY
	int "MPD detection sensitivity level (0..5)"
	range 0 5
	default 0

config IWRL6322_MPD_SNR_BOOST
	int "MPD SNR boost level (0=disabled, 1=level1, 2=level2)"
	range 0 2
	default 0

config IWRL6322_MPD_STATIC_REMOVAL
	bool "MPD enable static object removal"
	default y

config IWRL6322_MPD_NUM_FRAMES
	int "MPD number of frames per start command (0=infinite)"
	range 0 65535
	default 0

config IWRL6322_MPD_FRAME_PERIOD_MS
	int "MPD frame periodicity (ms, 1..86400000)"
	range 1 86400000
	default 1000

config IWRL6322_MPD_ADV_CFAR_CFG
	int "MPD advanced CFAR offset (-6..+6, added to nominal LUT value)"
	range -6 6
	default 0

config IWRL6322_MPD_MIN_POINTS
	int "Minimum number of detected points required to form a cluster (1 - 255)"
	range 1 255
	default 2

config IWRL6322_MPD_MAX_DISTANCE_CLUSTER
	int "Maximum distance between detected points for the points to be grouped into the same cluster (1 - 32767, 1 LSB = 1 cm)"
	range 1 32767
	default 50

config IWRL6322_MPD_STEER_VEC_EN_CTRL
	int "Steering vector enable control for this profile. When enabled, the device uses steering vector DPU for angle estimation instead of AOA DPU. (0 = enabled)"
	range 0 1
	default 0

