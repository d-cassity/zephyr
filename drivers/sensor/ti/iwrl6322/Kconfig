	int "FE number of chirps per burst (1..1023)"
	range 1 1023
	default 128

config IWRL6322_FE_BURST_IDLE_TIME
	int "FE burst idle time (100 ns LSB, 1500..150000)"
	range 1500 150000
	default 8010

